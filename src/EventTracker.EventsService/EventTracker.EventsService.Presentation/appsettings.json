{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eventtracker_events;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyForEventTrackerMicroservicesDevelopmentOnly!",
    "Issuer": "EventTracker",
    "Audience": "EventTracker",
    "ExpiresHours": "24"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-service"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Cache": {
    "EventTtlSeconds": 300,
    "TopEventsTtlSeconds": 60
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  }
}
