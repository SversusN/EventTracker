{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=eventtracker_bookings;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyForEventTrackerMicroservicesDevelopmentOnly!",
    "Issuer": "EventTracker",
    "Audience": "EventTracker",
    "ExpiresHours": "24"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Booking": {
    "MaxActiveBookingsPerUser": 10
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  }
}
